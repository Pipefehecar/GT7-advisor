# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./gt7_advisor.db
# PostgreSQL (switch when you're ready):
# DATABASE_URL=postgresql+asyncpg://gt7:gt7pass@db:5432/gt7_advisor

# ── PlayStation IP ────────────────────────────────────────────────────────────
PS_IP=192.168.1.100

# ── LLM provider: anthropic | openai | ollama ────────────────────────────────
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-opus-4-6

# OpenAI (optional)
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o

# Ollama (optional — local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── OCR provider: anthropic | google_vision | tesseract ──────────────────────
# Uses the same API keys as the LLM provider when applicable.
OCR_PROVIDER=anthropic

# ── GT7 community catalog (ddm999 — no auth needed) ──────────────────────────
GT7_CARS_CSV_URL=https://ddm999.github.io/gt7info/data/db/cars.csv
